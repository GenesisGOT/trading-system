# ════════════════════════════════════════════════════════════════════════════
#  Multi-Agent Trading System — Environment Configuration
#  Copy this file to .env and fill in your values before deploying.
# ════════════════════════════════════════════════════════════════════════════

# ── LLM Provider ($0 free default: Groq) ─────────────────────────────────────
# Groq is FREE — sign up at console.groq.com, no credit card required.
# 30 requests/min, 14,400 req/day — plenty for hourly stock analysis.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...                        # Get free at console.groq.com

# Models (Groq free tier — Llama 3.3 70B is top quality, completely free)
DEEP_THINK_LLM=llama-3.3-70b-versatile     # Debates, judge decisions
QUICK_THINK_LLM=llama-3.1-8b-instant       # Fast analyst passes

# ── Alternative providers (optional, paid) ────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...                        # Gemini Flash also has a free tier
# OPENROUTER_API_KEY=sk-or-...             # 28+ free models at openrouter.ai

# ── Robinhood / Vibe-Trading ──────────────────────────────────────────────────
# URL of the Robinhood MCP OAuth server (provided by Robinhood Agentic Trading)
ROBINHOOD_MCP_URL=https://your-robinhood-mcp-endpoint.example.com

# Optional: bearer token if you deploy Vibe-Trading's API server separately
VIBE_TRADING_API_KEY=

# ── Mandate — hard caps enforced BEFORE any order reaches the broker ──────────
# Comma-separated list of tickers this system is allowed to trade
MANDATE_ALLOWED_SYMBOLS=AAPL,MSFT,GOOGL

# Maximum notional value (USD) per single order
MANDATE_MAX_ORDER_USD=500

# Maximum total USD of orders to submit in a single calendar day
MANDATE_DAILY_CAP_USD=2000

# Maximum total open exposure (USD) across all positions
MANDATE_MAX_EXPOSURE_USD=10000

# Maximum number of individual orders per day (separate from dollar cap)
MANDATE_MAX_TRADES_PER_DAY=5

# ── Market Scanner (Polygon.io — free at polygon.io, no credit card) ─────────
# Scans top gainers/losers/volume across entire US equity market each cycle.
# Leave blank to fall back to MANDATE_ALLOWED_SYMBOLS fixed list.
POLYGON_API_KEY=

# Number of top tickers to analyze each cycle (default: 5)
SCANNER_MAX_TICKERS=5

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often (in minutes) to run the full agent analysis loop
LOOP_INTERVAL_MINUTES=60

# ── Notifications ─────────────────────────────────────────────────────────────
# Discord: paste your webhook URL from Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram: create a bot via @BotFather and get its token; get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Safety ────────────────────────────────────────────────────────────────────
# DRY_RUN=true  → agents analyse and log, but NO orders are submitted to Robinhood
# Set to false only after you have verified the system works correctly.
DRY_RUN=true

DEBUG=false
