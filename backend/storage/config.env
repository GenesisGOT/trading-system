# Set a stable secret key for production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=...

# Other parameters: REGISTER_ENABLE, ACCESS_TOKEN_EXPIRE_MINUTES, REFRESH_TOKEN_EXPIRE_MINUTES
# REGISTER_ENABLE=false
# ACCESS_TOKEN_EXPIRE_MINUTES=...
# REFRESH_TOKEN_EXPIRE_MINUTES=...

# ─── Robinhood credentials ────────────────────────────────────────────────────
# Required for live account data (robin_stocks).
# RH_USERNAME=your@email.com
# RH_PASSWORD=yourpassword
# RH_MFA_CODE=123456      # optional — only if 2FA is enabled on the account

# ─── RobinhoodMCP trade execution ────────────────────────────────────────────
# Required to place orders via https://agent.robinhood.com/mcp/trading
# Obtain from Robinhood Agentic Trading settings.
# ROBINHOOD_MCP_TOKEN=...

# ─── Safety switch ───────────────────────────────────────────────────────────
# Set to true to log orders without actually sending them to Robinhood.
# DRY_RUN=true